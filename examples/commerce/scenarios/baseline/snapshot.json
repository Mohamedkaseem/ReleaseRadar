{
  "label": "Baseline",
  "description": "Stable API contract. All checkout checks pass.",
  "complete": true,
  "services": [
    {
      "id": "identity",
      "name": "Identity",
      "team": "Platform",
      "criticality": "high",
      "source": "examples/commerce/shared/services.ts"
    },
    {
      "id": "orders",
      "name": "Orders",
      "team": "Commerce",
      "criticality": "high",
      "source": "examples/commerce/shared/services.ts"
    },
    {
      "id": "checkout",
      "name": "Checkout",
      "team": "Payments",
      "criticality": "high",
      "source": "examples/commerce/shared/services.ts"
    }
  ],
  "endpoints": [
    {
      "id": "identity.customer",
      "serviceId": "identity",
      "method": "GET",
      "route": "/customers/:id",
      "fields": [
        {
          "name": "customerId",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "orders.create",
      "serviceId": "orders",
      "method": "POST",
      "route": "/orders",
      "fields": [
        {
          "name": "orderId",
          "type": "string",
          "required": true
        },
        {
          "name": "internalTag",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "id": "checkout.complete",
      "serviceId": "checkout",
      "method": "POST",
      "route": "/checkout",
      "fields": [
        {
          "name": "status",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "dependencies": [
    {
      "caller": "orders",
      "provider": "identity",
      "endpointId": "identity.customer",
      "fields": ["customerId"],
      "source": "examples/commerce/shared/services.ts"
    },
    {
      "caller": "checkout",
      "provider": "orders",
      "endpointId": "orders.create",
      "fields": ["orderId"],
      "source": "examples/commerce/shared/services.ts"
    }
  ],
  "workflows": [
    {
      "id": "purchase",
