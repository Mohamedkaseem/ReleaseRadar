    },
    {
      "id": "customer-profile",
      "name": "Read customer profile",
      "services": ["identity"]
    }
  ],
  "tests": [
    {
      "id": "checkout",
      "name": "Checkout integration",
      "workflowId": "purchase"
    },
    {
      "id": "identity-contract",
      "name": "Identity response contract",
