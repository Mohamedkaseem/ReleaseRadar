{
  "name": "release-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "RR_HISTORY_GRAPH=rr_test_history tsx --test tests/integration/*.test.ts",
    "evaluate": "RR_HISTORY_GRAPH=rr_evaluation_history tsx scripts/evaluate.ts",
    "db:up": "docker compose up -d falkordb",
    "db:down": "docker compose stop falkordb",
    "verify:baseline": "tsx examples/commerce/verify.ts baseline checkout",
    "verify:breaking": "tsx examples/commerce/verify.ts breaking checkout",
    "format": "prettier --write src examples scripts tests vite.config.ts",
    "format:check": "prettier --check src examples scripts tests vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@xyflow/react": "^12.8.0",
    "dotenv": "^16.6.0",
    "falkordb": "^6.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
